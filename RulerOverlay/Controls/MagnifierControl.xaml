<UserControl x:Class="RulerOverlay.Controls.MagnifierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="200" Height="200">

    <Border BorderBrush="Cyan"
            BorderThickness="2"
            CornerRadius="3"
            Background="Black"
            ClipToBounds="True">
        <Grid>
            <!-- Magnified Image -->
            <Image x:Name="MagnifierImage"
                   Stretch="None"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!--
                Crosshair. Laid out with alignment rather than fixed coordinates so it stays
                centred if the magnifier size ever changes.
            -->
            <Rectangle Width="1"
                       Fill="Red"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Stretch"/>

            <Rectangle Height="1"
                       Fill="Red"
                       Opacity="0.7"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"/>

            <Ellipse Width="6" Height="6"
                     Fill="Red"
                     Stroke="White"
                     StrokeThickness="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>

            <!-- Position along the ruler, in the active unit -->
            <TextBlock x:Name="PositionText"
                       Text=""
                       Foreground="Yellow"
                       Background="#CC000000"
                       Padding="5,2"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="5,0,0,5"
                       Visibility="Collapsed"/>

            <!-- Zoom Level Indicator -->
            <TextBlock x:Name="ZoomLevelText"
                       Text=""
                       Foreground="White"
                       Background="#CC000000"
                       Padding="5,2"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,5,5"/>
        </Grid>
    </Border>
</UserControl>
