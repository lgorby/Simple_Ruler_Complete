<UserControl x:Class="RulerOverlay.Controls.MagnifierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="200" Height="200">

    <Border BorderBrush="Cyan"
            BorderThickness="2"
            CornerRadius="3"
            Background="Black"
            ClipToBounds="True">
        <Grid>
            <!-- Magnified Image -->
            <Image x:Name="MagnifierImage"
                   Stretch="None"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!--
                Open reticle. The crosshair is split into four segments and the centre marker
                is a hollow circle, so the pixel under the cursor - the whole reason to
                magnify - is never painted over. A solid dot or an unbroken crosshair hides
                exactly what the user is trying to read.

                Built from a 3x3 grid rather than fixed coordinates so it stays centred if
                the magnifier size changes; the middle cell is the clear zone.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Crosshair arms, stopping at the edge of the clear centre -->
                <Rectangle Grid.Row="0" Grid.Column="1" Width="1" Fill="Red" Opacity="0.75"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <Rectangle Grid.Row="2" Grid.Column="1" Width="1" Fill="Red" Opacity="0.75"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <Rectangle Grid.Row="1" Grid.Column="0" Height="1" Fill="Red" Opacity="0.75"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Rectangle Grid.Row="1" Grid.Column="2" Height="1" Fill="Red" Opacity="0.75"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                <!-- Hollow centre marker: outlined, never filled -->
                <Ellipse Grid.Row="1" Grid.Column="1"
                         Width="14" Height="14"
                         Fill="Transparent"
                         Stroke="Red"
                         StrokeThickness="1"
                         Opacity="0.9"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- Position along the ruler, in the active unit -->
            <TextBlock x:Name="PositionText"
                       Text=""
                       Foreground="Yellow"
                       Background="#CC000000"
                       Padding="5,2"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="5,0,0,5"
                       Visibility="Collapsed"/>

            <!-- Zoom Level Indicator -->
            <TextBlock x:Name="ZoomLevelText"
                       Text=""
                       Foreground="White"
                       Background="#CC000000"
                       Padding="5,2"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,5,5"/>
        </Grid>
    </Border>
</UserControl>
