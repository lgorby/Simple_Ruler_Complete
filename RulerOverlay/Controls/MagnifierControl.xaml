<UserControl x:Class="RulerOverlay.Controls.MagnifierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="200" Height="200">

    <Border BorderBrush="Cyan"
            BorderThickness="2"
            CornerRadius="3"
            Background="Black"
            ClipToBounds="True">
        <Grid>
            <!-- Magnified Image -->
            <Image x:Name="MagnifierImage"
                   Stretch="None"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!--
                Open reticle, sized in real device pixels.

                Every stroke is one physical pixel: a WPF "1" is one device-independent
                pixel, which on a scaled display is a fraction of a device pixel and gets
                antialiased across two, so nothing lines up with what is being measured.
                EdgeMode=Aliased plus a thickness of 1/DPI keeps each line exactly one
                pixel and perfectly crisp.

                The square marks the single source pixel under the cursor. It is offset by
                half a magnified pixel because the capture centres the cursor's pixel at
                the image's midpoint, which is that pixel's leading EDGE - without the
                shift the crosshair marks the corner between four pixels rather than one.

                Metrics are applied in code-behind, where the zoom level and DPI are known.
            -->
            <Grid x:Name="Reticle"
                  RenderOptions.EdgeMode="Aliased"
                  UseLayoutRounding="True">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ReticleOffset"/>
                </Grid.RenderTransform>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ReticleGapColumn" Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="ReticleGapRow" Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Crosshair arms, stopping clear of the marked pixel -->
                <Rectangle x:Name="CrosshairTop" Grid.Row="0" Grid.Column="1"
                           Fill="Red" Opacity="0.75"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <Rectangle x:Name="CrosshairBottom" Grid.Row="2" Grid.Column="1"
                           Fill="Red" Opacity="0.75"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <Rectangle x:Name="CrosshairLeft" Grid.Row="1" Grid.Column="0"
                           Fill="Red" Opacity="0.75"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Rectangle x:Name="CrosshairRight" Grid.Row="1" Grid.Column="2"
                           Fill="Red" Opacity="0.75"
                           HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                <!-- Outline of the exact source pixel under the cursor -->
                <Rectangle x:Name="PixelMarker" Grid.Row="1" Grid.Column="1"
                           Fill="Transparent"
                           Stroke="Red"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Position along the ruler, in the active unit -->
            <TextBlock x:Name="PositionText"
                       Text=""
                       Foreground="Yellow"
                       Background="#CC000000"
                       Padding="5,2"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="5,0,0,5"
                       Visibility="Collapsed"/>

            <!-- Zoom Level Indicator -->
            <TextBlock x:Name="ZoomLevelText"
                       Text=""
                       Foreground="White"
                       Background="#CC000000"
                       Padding="5,2"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,5,5"/>
        </Grid>
    </Border>
</UserControl>
