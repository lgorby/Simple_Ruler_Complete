<Window x:Class="RulerOverlay.Windows.RulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RulerOverlay.Converters"
        xmlns:controls="clr-namespace:RulerOverlay.Controls"
        mc:Ignorable="d"
        Title="Ruler Overlay"
        Width="500" Height="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!--
            One equality converter serves the unit, colour, opacity and rotation menus;
            one text converter serves both Enable/Disable toggles, with the two captions
            passed as the parameter.
        -->
        <converters:EqualsConverter x:Key="EqualsConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>

        <!-- Mini Icon Button Style -->
        <Style x:Key="MiniIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#80FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B0FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#60FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared context menu, so the right-click menu and the ☰ button open the same one -->
        <ContextMenu x:Key="RulerContextMenu">
            <!-- Position -->
            <MenuItem Header="Reset to Center"
                      Command="{Binding ResetPositionCommand}"
                      InputGestureText="Ctrl+R"/>

            <Separator/>

            <!-- Calibration -->
            <MenuItem Header="Calibrate Screen..."
                      Click="CalibrateScreen_Click"/>
            <MenuItem Header="{Binding Ppi, StringFormat='Current PPI: {0}'}"
                      IsEnabled="False"/>

            <Separator/>

            <!-- Help -->
            <MenuItem Header="Help &amp; Shortcuts"
                      Click="ShowHelp_Click"
                      InputGestureText="F1"/>

            <Separator/>

            <!-- Copy -->
            <MenuItem Header="Copy Measurement"
                      Command="{Binding CopyMeasurementCommand}"
                      InputGestureText="Ctrl+C"/>
            <MenuItem Header="{Binding FormattedLength, StringFormat='Current: {0}'}"
                      IsEnabled="False"/>

            <Separator/>

            <!-- Measurement Unit -->
            <MenuItem Header="Measurement Unit">
                <MenuItem Header="Pixels"
                          Command="{Binding SetUnitCommand}"
                          CommandParameter="pixels"
                          IsCheckable="True"
                          IsChecked="{Binding UnitKey, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=pixels}"/>
                <MenuItem Header="Inches"
                          Command="{Binding SetUnitCommand}"
                          CommandParameter="inches"
                          IsCheckable="True"
                          IsChecked="{Binding UnitKey, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=inches}"/>
                <MenuItem Header="Centimeters"
                          Command="{Binding SetUnitCommand}"
                          CommandParameter="centimeters"
                          IsCheckable="True"
                          IsChecked="{Binding UnitKey, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=centimeters}"/>
            </MenuItem>

            <Separator/>

            <!-- Transparency -->
            <MenuItem Header="Transparency">
                <MenuItem Header="20%"
                          Command="{Binding SetOpacityCommand}"
                          CommandParameter="20"
                          IsCheckable="True"
                          IsChecked="{Binding Opacity, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=20}"/>
                <MenuItem Header="40%"
                          Command="{Binding SetOpacityCommand}"
                          CommandParameter="40"
                          IsCheckable="True"
                          IsChecked="{Binding Opacity, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=40}"/>
                <MenuItem Header="60%"
                          Command="{Binding SetOpacityCommand}"
                          CommandParameter="60"
                          IsCheckable="True"
                          IsChecked="{Binding Opacity, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=60}"/>
                <MenuItem Header="80%"
                          Command="{Binding SetOpacityCommand}"
                          CommandParameter="80"
                          IsCheckable="True"
                          IsChecked="{Binding Opacity, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=80}"/>
                <MenuItem Header="100%"
                          Command="{Binding SetOpacityCommand}"
                          CommandParameter="100"
                          IsCheckable="True"
                          IsChecked="{Binding Opacity, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=100}"/>
            </MenuItem>

            <Separator/>

            <!-- Color -->
            <MenuItem Header="Color">
                <MenuItem Header="White"
                          Command="{Binding SetColorCommand}"
                          CommandParameter="white"
                          IsCheckable="True"
                          IsChecked="{Binding Color, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=white}"/>
                <MenuItem Header="Black"
                          Command="{Binding SetColorCommand}"
                          CommandParameter="black"
                          IsCheckable="True"
                          IsChecked="{Binding Color, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=black}"/>
                <MenuItem Header="Yellow"
                          Command="{Binding SetColorCommand}"
                          CommandParameter="yellow"
                          IsCheckable="True"
                          IsChecked="{Binding Color, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=yellow}"/>
                <MenuItem Header="Cyan"
                          Command="{Binding SetColorCommand}"
                          CommandParameter="cyan"
                          IsCheckable="True"
                          IsChecked="{Binding Color, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=cyan}"/>
            </MenuItem>

            <Separator/>

            <!-- Point-to-Point -->
            <MenuItem Header="Point-to-Point Mode"
                      Click="PointToPointMode_Click"
                      InputGestureText="Ctrl+P"/>

            <!-- Edge Guides -->
            <MenuItem Header="Clear All Guides"
                      Command="{Binding ClearGuidesCommand}"
                      InputGestureText="Ctrl+G"/>

            <Separator/>

            <!-- Magnifier -->
            <MenuItem Header="{Binding MagnifierEnabled, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Enable Magnifier|Disable Magnifier'}"
                      Command="{Binding ToggleMagnifierCommand}"
                      InputGestureText="Ctrl+M"
                      IsCheckable="True"
                      IsChecked="{Binding MagnifierEnabled, Mode=OneWay}"/>

            <!-- Click-Through -->
            <MenuItem Header="{Binding ClickThroughEnabled, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Enable Click-Through|Disable Click-Through'}"
                      Command="{Binding ToggleClickThroughCommand}"
                      InputGestureText="Ctrl+K"
                      IsCheckable="True"
                      IsChecked="{Binding ClickThroughEnabled, Mode=OneWay}"/>

            <!-- Edge Snapping -->
            <MenuItem Header="{Binding EdgeSnappingEnabled, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Enable Edge Snapping|Disable Edge Snapping'}"
                      Command="{Binding ToggleEdgeSnappingCommand}"
                      InputGestureText="Ctrl+S"
                      IsCheckable="True"
                      IsChecked="{Binding EdgeSnappingEnabled, Mode=OneWay}"/>

            <Separator/>

            <!-- Window Management -->
            <MenuItem Header="Minimize to System Tray"
                      Click="MinimizeToTray_Click"/>

            <Separator/>

            <!-- Rotation. Angles mirror RulerDefaults.RotationPresets. -->
            <MenuItem Header="Rotation">
                <MenuItem Header="0° (Horizontal)"
                          Command="{Binding SetRotationCommand}"
                          CommandParameter="0"
                          IsCheckable="True"
                          IsChecked="{Binding Rotation, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"/>
                <MenuItem Header="45°"
                          Command="{Binding SetRotationCommand}"
                          CommandParameter="45"
                          IsCheckable="True"
                          IsChecked="{Binding Rotation, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=45}"/>
                <MenuItem Header="90° (Vertical)"
                          Command="{Binding SetRotationCommand}"
                          CommandParameter="90"
                          IsCheckable="True"
                          IsChecked="{Binding Rotation, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=90}"/>
                <MenuItem Header="135°"
                          Command="{Binding SetRotationCommand}"
                          CommandParameter="135"
                          IsCheckable="True"
                          IsChecked="{Binding Rotation, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=135}"/>
                <MenuItem Header="180°"
                          Command="{Binding SetRotationCommand}"
                          CommandParameter="180"
                          IsCheckable="True"
                          IsChecked="{Binding Rotation, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=180}"/>
            </MenuItem>

            <Separator/>

            <MenuItem Header="Close"
                      Click="CloseApp_Click"
                      InputGestureText="Ctrl+Q"/>
        </ContextMenu>
    </Window.Resources>

    <Canvas x:Name="RootCanvas">
        <Grid x:Name="RootGrid"
              Width="{Binding Width}"
              Height="{Binding Height}">
            <!-- Rotation and Translation Transform -->
            <!--
                Transform order is scale, then rotate, then translate.

                The scale is set to 1/DPI in code-behind, which makes one unit inside
                RootGrid equal exactly one physical screen pixel. Without it the ruler is
                laid out in WPF's device-independent pixels, so on a 125% display a ruler
                labelled "500 px" actually spans 625 real pixels - and the inch/cm
                conversions, whose PPI is derived from the monitor's physical resolution,
                are wrong by the same factor.
            -->
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PixelScaleTransform"/>
                    <RotateTransform x:Name="RotationTransform" Angle="{Binding Rotation}"/>
                    <TranslateTransform x:Name="TranslationTransform"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Main Ruler Background -->
            <Border x:Name="RulerBackground"
                    Background="{Binding BackgroundBrush}"
                    CornerRadius="3"
                    ContextMenu="{StaticResource RulerContextMenu}"
                    ContextMenuOpening="RulerBackground_ContextMenuOpening">

                <Grid ClipToBounds="True">
                    <!-- Ruler Markings - canvas size matches ruler dimensions -->
                    <Canvas x:Name="MarkingsCanvas"
                            Width="{Binding Width}"
                            Height="{Binding Height}"/>

                    <!-- Edge Guides -->
                    <ItemsControl ItemsSource="{Binding EdgeGuides}"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Position}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    The guide spans the ruler's full height, taken from the
                                    ViewModel rather than a hard-coded value, so it still
                                    reaches both edges if the ruler height changes.
                                -->
                                <Grid>
                                    <Rectangle Width="2"
                                               Height="{Binding DataContext.Height,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                               Fill="Magenta"
                                               Opacity="0.8"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="Magenta" BlurRadius="6"
                                                              ShadowDepth="0" Opacity="0.6"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="9"
                                               RenderTransformOrigin="0,1"
                                               Foreground="Magenta"
                                               FontWeight="Bold"
                                               Margin="4,0,0,2"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform
                                                ScaleX="{Binding DataContext.PixelScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ScaleY="{Binding DataContext.PixelScale, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Mini Function Icons (visible on hover) -->
                    <!--
                        RootGrid is scaled by 1/DPI so its units are real pixels. Chrome is
                        scaled back up by the same factor, otherwise the buttons and grab
                        handles shrink on a high-DPI display.
                    -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform ScaleX="{Binding PixelScale}" ScaleY="{Binding PixelScale}"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RulerBackground}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="IsHitTestVisible" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Content="▼"
                                Click="MinimizeToTray_Click"
                                ToolTip="Minimize to System Tray"
                                Style="{StaticResource MiniIconButtonStyle}"/>

                        <Button Click="QuickRotate_Click"
                                ToolTip="Next preset angle"
                                Style="{StaticResource MiniIconButtonStyle}">
                            <TextBlock Text="⤾" Margin="0,-4,0,0"/>
                        </Button>

                        <Button Content="⟷"
                                Click="PointToPointMode_Click"
                                ToolTip="Point-to-Point Mode (Ctrl+P)"
                                Style="{StaticResource MiniIconButtonStyle}"/>

                        <Button Content="☰"
                                Click="ShowContextMenu_Click"
                                ToolTip="Options"
                                Style="{StaticResource MiniIconButtonStyle}"/>

                        <Button Content="✕"
                                Click="CloseApp_Click"
                                ToolTip="Close (Ctrl+Q)"
                                Style="{StaticResource MiniIconButtonStyle}"/>
                    </StackPanel>

                    <!--
                        Resize handles. Edges change one dimension, corners change both.
                        Corners are declared last so they sit above the edge strips they
                        overlap and win the hit test.
                    -->
                    <Rectangle x:Name="LeftResizeHandle"
                               Width="{Binding ResizeHandleWidth}"
                               Fill="Transparent"
                               HorizontalAlignment="Left"
                               MouseDown="LeftResizeHandle_MouseDown"
                               MouseMove="ResizeHandle_MouseMove"
                               MouseUp="ResizeHandle_MouseUp"/>

                    <Rectangle x:Name="RightResizeHandle"
                               Width="{Binding ResizeHandleWidth}"
                               Fill="Transparent"
                               HorizontalAlignment="Right"
                               MouseDown="RightResizeHandle_MouseDown"
                               MouseMove="ResizeHandle_MouseMove"
                               MouseUp="ResizeHandle_MouseUp"/>

                    <Rectangle x:Name="TopResizeHandle"
                               Height="{Binding ResizeHandleWidth}"
                               Fill="Transparent"
                               VerticalAlignment="Top"
                               MouseDown="TopResizeHandle_MouseDown"
                               MouseMove="ResizeHandle_MouseMove"
                               MouseUp="ResizeHandle_MouseUp"/>

                    <Rectangle x:Name="BottomResizeHandle"
                               Height="{Binding ResizeHandleWidth}"
                               Fill="Transparent"
                               VerticalAlignment="Bottom"
                               MouseDown="BottomResizeHandle_MouseDown"
                               MouseMove="ResizeHandle_MouseMove"
                               MouseUp="ResizeHandle_MouseUp"/>

                    <Rectangle x:Name="TopLeftResizeHandle"
                               Width="{Binding ResizeHandleWidth}"
                               Height="{Binding ResizeHandleWidth}"
                               Fill="Transparent"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               MouseDown="TopLeftResizeHandle_MouseDown"
                               MouseMove="ResizeHandle_MouseMove"
                               MouseUp="ResizeHandle_MouseUp"/>

                    <Rectangle x:Name="TopRightResizeHandle"
                               Width="{Binding ResizeHandleWidth}"
                               Height="{Binding ResizeHandleWidth}"
                               Fill="Transparent"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               MouseDown="TopRightResizeHandle_MouseDown"
                               MouseMove="ResizeHandle_MouseMove"
                               MouseUp="ResizeHandle_MouseUp"/>

                    <Rectangle x:Name="BottomLeftResizeHandle"
                               Width="{Binding ResizeHandleWidth}"
                               Height="{Binding ResizeHandleWidth}"
                               Fill="Transparent"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               MouseDown="BottomLeftResizeHandle_MouseDown"
                               MouseMove="ResizeHandle_MouseMove"
                               MouseUp="ResizeHandle_MouseUp"/>

                    <Rectangle x:Name="BottomRightResizeHandle"
                               Width="{Binding ResizeHandleWidth}"
                               Height="{Binding ResizeHandleWidth}"
                               Fill="Transparent"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               MouseDown="BottomRightResizeHandle_MouseDown"
                               MouseMove="ResizeHandle_MouseMove"
                               MouseUp="ResizeHandle_MouseUp"/>
                </Grid>
            </Border>

        </Grid>

        <!--
            Toast lives in a popup rather than inside RootGrid. Inside the grid it would
            inherit the ruler's rotation and be clipped by the window, which is only as
            large as the ruler itself; it also previously carried Panel.ZIndex="-1", which
            hid it behind the opaque ruler background entirely.
        -->
        <Popup x:Name="ToastPopup"
               Placement="Absolute"
               AllowsTransparency="True"
               IsOpen="False">
            <controls:ToastControl x:Name="Toast"/>
        </Popup>

        <!-- Live angle while free-rotating; a popup so it is neither rotated nor clipped -->
        <Popup x:Name="AngleReadoutPopup"
               Placement="Absolute"
               AllowsTransparency="True"
               IsOpen="False">
            <Border Background="#DD000000" CornerRadius="3" Padding="8,4"
                    BorderBrush="Cyan" BorderThickness="1">
                <TextBlock x:Name="AngleReadoutText"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"/>
            </Border>
        </Popup>

        <!-- Magnifier popup lives outside RootGrid so ruler rotation does not tilt it -->
        <Popup x:Name="MagnifierPopup"
               Placement="Absolute"
               AllowsTransparency="True"
               IsOpen="False">
            <controls:MagnifierControl x:Name="Magnifier"/>
        </Popup>
    </Canvas>
</Window>
